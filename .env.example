# Saubermatik Website — Umgebungsvariablen (Vorlage)
# Kopieren: cp .env.example .env.local  →  Werte anpassen

# --- Client (NEXT_PUBLIC_*) ---
# SaaS-Kundenplattform (Header „Kunden-Login“)
NEXT_PUBLIC_PLATFORM_URL=

# Bewerbungs-E-Mail für mailto:-Links auf /karriere
NEXT_PUBLIC_CAREER_EMAIL=info@saubermatik-reinigung.de

# Öffentliche Site-URL (JSON-LD, Canonical, Sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Telefon (Header, Footer, tel:-Links) — kanonisch +49 1512 9860059
NEXT_PUBLIC_BUSINESS_PHONE=+4915129860059

# --- E-Mail (Server only, niemals NEXT_PUBLIC) ---
RESEND_API_KEY=
RESEND_FROM_LIVE=Saubermatik <noreply@example.de>
LEAD_EMAIL_RECIPIENT=
LEAD_NOTIFICATION_EMAIL=
CAREER_EMAIL_RECIPIENT=
